# Standardify Backend — Environment Variables Template
# Copy this file to .env and provide appropriate values.
# NEVER commit .env to version control or hardcode secrets in source code.

# LLM Provider API Keys (Required)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# Vector Database Persistence Directory
CHROMA_PERSIST_DIR=./data/chroma_store

# Primary LLM Provider (groq | gemini)
LLM_PRIMARY_PROVIDER=groq

# Logging Verbosity Level (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO

# Caching Configuration (TTL in seconds)
CACHE_TTL_SECONDS=86400

# Retrieval & Evidence Threshold
CONFIDENCE_FLOOR=0.35
