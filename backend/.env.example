# ── Standardify Backend — Environment Variables ──────────────────────────────
# Copy this file to .env and fill in values you have.
# ALL variables are optional — the app runs in demo mode with zero keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM API Keys (both optional — app falls back to extractive mode if absent) ──
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# Get a free key at https://aistudio.google.com
GEMINI_API_KEY=

# ── Paths (defaults work for local dev, override for Docker/cloud) ────────────
# Path where ChromaDB stores its persistent data
CHROMA_PATH=./data/chroma

# Path to the folder containing raw standards documents (.txt / .pdf)
STANDARDS_RAW_PATH=./data/standards_raw

# Path to the knowledge graph relationships JSON file
GRAPH_JSON_PATH=./data/graph_relationships.json

# ── Server Config ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins (default: all origins for dev)
# Example for prod: CORS_ORIGINS=https://standardify.vercel.app
CORS_ORIGINS=*

# Port for uvicorn (used by start scripts — uvicorn itself is started with --port)
PORT=8000

# ── Embedding Model ───────────────────────────────────────────────────────────
# HuggingFace model name for sentence embeddings (must match what was used for ingestion)
EMBEDDING_MODEL=BAAI/bge-m3

# ChromaDB collection name
CHROMA_COLLECTION=standards_v1

# ── Groq Model ────────────────────────────────────────────────────────────────
GROQ_MODEL=llama-3.3-70b-versatile

# ── Gemini Model ─────────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.0-flash
