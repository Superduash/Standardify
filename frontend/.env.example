# Base URL of the Standardify FastAPI backend, INCLUDING the /api/v1 prefix
# — see FRONTEND_CONTRACT.md §1. Local default matches
# `uvicorn app.main:app --reload`'s default port.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Debug panel (Phase 10) — shows /health and /health/quota in a corner panel.
# Set to "true" ONLY for team/demo diagnostics. Never expose to end users.
# When unset or "false" the panel is completely absent from the rendered UI.
VITE_SHOW_DEBUG_PANEL=false
